{
  "name": "feishu-omp-bridge",
  "version": "0.1.0",
  "description": "Continue local Codex sessions from Feishu or Lark without exposing a public webhook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lengjingxu/feishu-codex-bridge.git"
  },
  "homepage": "https://github.com/lengjingxu/feishu-codex-bridge#readme",
  "bugs": {
    "url": "https://github.com/lengjingxu/feishu-codex-bridge/issues"
  },
  "type": "module",
  "bin": {
    "feishu-codex-bridge": "./bin/feishu-omp-bridge.mjs",
    "feishu-omp-bridge": "./bin/feishu-omp-bridge.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README.en.md",
    "AGENT_INSTALL.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "audit": "pnpm audit --audit-level=high --registry=https://registry.npmjs.org",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "commander": "^12.1.0",
    "https-proxy-agent": "^9.1.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  },
  "packageManager": "pnpm@10.26.1",
  "keywords": [
    "feishu",
    "lark",
    "omp",
    "oh-my-pi",
    "codex",
    "app-server",
    "cli",
    "channel",
    "bridge"
  ],
  "license": "MIT"
}
